PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/alchemy
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
# When true, the OTP is returned in the API response instead of being sent by SMS.
OTP_DEV_MODE=true

# Twilio SMS for OTP delivery. If any of these three is empty, OTPs are logged to the console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# OAuth audiences. Comma-separate multiple IDs (e.g. Google web + iOS + Android client IDs).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
